#!/usr/bin/env bash
# Nextflow runs containers with `podman`. On NERSC that must be podman-hpc, which keeps images
# where compute nodes can use them; plain podman is also installed there. scripts/run-pipeline.sh
# puts this folder first on PATH for the nersc profile, and Slurm passes PATH on to the tasks.
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# podman-hpc runs podman by name itself (e.g. to migrate images), so give it PATH without this
# folder, or that call would come back here.
path=":$PATH:"
path=${path//:$here:/:}
path=${path#:}
export PATH=${path%:}
# Close descriptors above stdin, stdout and stderr. Nextflow's job script starts the container
# under `3>&1 1>&2 2>&3 | tee .command.err`, which leaves fd 3 open on the pipe into that tee.
# podman-hpc's squashfuse daemon inherits it and can outlive the container, so the tee never sees
# end of file and the job waits, finished, until its time limit.
for fd in {3..63}; do
    eval "exec $fd>&-"
done
exec podman-hpc "$@"
