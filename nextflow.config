manifest {
    name = 'kundajelab/genesis'
    version = '0.1.0'
    description = 'Plant DAP-seq processing with bwa-mem2, SPP, MACS3 and deepTools'
    nextflowVersion = '>=25.10.4,<26'
    mainScript = 'workflows/dap-seq.nf'
}
plugins {
    id 'nf-schema@2.4.2'
    id 'nf-dotenv@1.0.0'
}
// nf-schema otherwise looks for the parameter schema beside the main script.
validation {
    parametersSchema = "${projectDir.parent}/nextflow_schema.json"
}
// nf-dotenv resolves this relative to projectDir (workflows/), so step up to the repository.
dotenv {
    filename = 'conf/dap-images.lock'
    relative = '..'
}
params {
    input = null
    // Folder for this run under workspace. Defaults to the input sheet's basename without .tsv.
    run_name = null
    // projectDir is the main script's folder, workflows/; these live at the repository root.
    references = "${projectDir.parent}/references"
    workspace = "${projectDir.parent}/workspace"
    cpus = 2
    memory = '8 GB'
    time = '4h'
    slurm_queue = 'normal'
    download_batch_size = 8
    bwa_batch_size = 10000000
    bwa_seed_length = 19
    bwa_max_seed_occurrences = 10000
    bwa_score_threshold = 30
    // SPP cross-correlation aligns read 1 cut to this many bases, as ENCODE does.
    spp_read_length = 50
    spp_script = "${projectDir.parent}/vendor/phantompeakqualtools/run_spp.R"
    trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

resume = true

// Each run keeps its work, published output, and trace files together under
// workspace/run_name. The "?." keeps the config parseable when --input is missing, so workflows/dap-seq.nf
// can report the problem.
params.run_dir = "${params.workspace}/${params.run_name ?: params.input?.toString()?.tokenize('/')?.last()?.replaceFirst(/\.tsv$/, '')}"
workDir = "${params.run_dir}/work"
process {
    executor = 'local'
    // stop on errors, log commands
    shell = ['/bin/bash', '-euxo', 'pipefail']
}
profiles {
    local {
        process.executor = 'local'
        // The local executor refuses tasks requesting more than this machine has, rather than
        // running them; clamp the self-sized requests (e.g. alignment cpus) to what is here.
        process.resourceLimits = [
            cpus: nextflow.util.SysHelper.getAvailCpus(),
            memory: nextflow.util.SysHelper.getAvailMemory(),
        ]
    }
    sherlock {
        process.executor = 'slurm'
        process.queue = params.slurm_queue
        executor.queueSize = 50
    }
    conda { conda.enabled = true }
    docker {
        conda.enabled = false
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        conda.enabled = false
        apptainer.enabled = true
    }
    test {
        params.cpus = 2
        params.memory = '2 GB'
        params.time = '5m'
        // Cap processes that size their own resources.
        process.resourceLimits = [cpus: 2, memory: 2.GB, time: 5.m]
    }
}
conda {
    useMicromamba = true
    cacheDir = "${params.workspace}/conda_cache"
    createTimeout = '1h'
}
apptainer {
    autoMounts = true
    cacheDir = "${params.workspace}/apptainer_cache"
}
timeline {
    enabled = true
    overwrite = true
    file = "${params.run_dir}/trace/execution_timeline_${params.trace_timestamp}.html"
}
report {
    enabled = true
    overwrite = true
    file = "${params.run_dir}/trace/execution_report_${params.trace_timestamp}.html"
}
trace {
    enabled = true
    overwrite = true
    file = "${params.run_dir}/trace/execution_trace_${params.trace_timestamp}.txt"
}
dag {
    enabled = true
    overwrite = true
    file = "${params.run_dir}/trace/pipeline_dag_${params.trace_timestamp}.html"
}

includeConfig 'conf/execution.config'
