manifest {
    name = 'kundajelab/genesis'
    version = '0.1.0'
    description = 'Plant DAP-seq processing with bwa-mem2, SPP, MACS3 and deepTools'
    nextflowVersion = '>=26.10.4,<27'
    mainScript = 'workflows/dap-seq.nf'
}
plugins {
    id 'nf-schema@2.8.0'
    id 'nf-dotenv@2.0.1'
}
// nf-dotenv resolves this relative to projectDir (workflows/), so step up to the repository.
dotenv {
    filename = 'conf/genesis-images.lock'
    relative = '..'
}
params {
    input = null
    // Folder for this run under workspace. Defaults to the input sheet's basename without .tsv.
    run_name = null
    // projectDir is the main script's folder, workflows/; these live at the repository root.
    references = "${projectDir.parent}/references"
    workspace = "${projectDir.parent}/workspace"
    // Long-term storage for published output and trace files, e.g. project storage where scratch
    // is purged. Unset, they stay in the run folder under workspace beside the work directory.
    persist_dir = null
    cpus = 2
    memory = '8 GB'
    time = '4h'
    // Slurm queue: the partition for the slurm and sherlock profiles, the QOS for nersc. Each
    // profile has its own default (regular, normal, shared); --queue overrides it.
    queue = null
    download_batch_size = 8
    trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

resume = true

// Each run keeps its work, published output, and trace files together under
// workspace/run_name. The "?." keeps the config parseable when --input is missing, so workflows/dap-seq.nf
// can report the problem.
params.run_dir = "${params.workspace}/${params.run_name ?: params.input?.toString()?.tokenize('/')?.last()?.replaceFirst(/\.tsv$/, '')}"
// Published output and trace files: persist_dir/run_name when persist_dir is set, else run_dir.
params.publish_base = params.persist_dir ?
    "${params.persist_dir}/${params.run_dir.toString().tokenize('/').last()}" : params.run_dir
workDir = "${params.run_dir}/work"
process {
    executor = 'local'
    // stop on errors, log commands
    shell = ['/bin/bash', '-euxo', 'pipefail']
}
profiles {
    local {
        process.executor = 'local'
        // The local executor refuses tasks requesting more than this machine has, rather than
        // running them; clamp the self-sized requests (e.g. alignment cpus) to what is here.
        process.resourceLimits = [
            cpus: nextflow.util.SysHelper.getAvailCpus(),
            memory: nextflow.util.SysHelper.getAvailMemory(),
        ]
    }
    sherlock {
        process.executor = 'slurm'
        // A partition; normal is Sherlock's general one. Evaluated per task, so --queue applies.
        process.queue = { params.queue ?: 'normal' }
        executor.queueSize = 50
        // Sherlock runs the images with Apptainer; Nextflow pulls them into apptainer.cacheDir.
        conda.enabled = false
        apptainer.enabled = true
    }
    nersc {
        // see https://docs.nersc.gov/jobs/workflow/nextflow/#nextflow-submits-tasks-as-slurm-jobs
        process.executor = 'slurm'
        // podman-hpc's image mounts count against the job's memory (a 1.5 GB image fails a 1 GB
        // job), so Slurm gets 4 GB more than the task; this --mem comes after Nextflow's and
        // overrides it. The container itself is still limited to the task's memory. The queue is a
        // QOS on Perlmutter, which picks the partition itself; shared charges only what a task uses.
        process.clusterOptions = {
            "--constraint=cpu --qos=${params.queue ?: 'shared'} --mem=${(task.memory ?: 1.GB).toMega() + 4096}M"
        }
        // The shared QOS allows at most half a node (128 of 256 CPUs, half of 503 GB) for 48 h;
        // leave room for the 4 GB added above, so a larger request is capped, not rejected.
        process.resourceLimits = [cpus: 128, memory: 247.GB, time: 48.h]
        executor.queueSize = 15
        executor.pollInterval = '5 min'
        executor.queueStatInterval = '5 min'
        executor.submitRateLimit = '20/1min'
        executor.dumpInterval = '6 min'
        executor.exitReadTimeout = '13 min'
        executor.killBatchSize = 30
        podman.enabled = true
        // The images run as a non-root user; map it to the caller so task files stay readable.
        podman.runOptions = '--userns=keep-id --user $(id -u):$(id -g)'
    }
    slurm {
        process.executor = 'slurm'
        // A partition. Evaluated per task, so --queue applies.
        process.queue = { params.queue ?: 'regular' }
    }
    conda { conda.enabled = true }
    docker {
        conda.enabled = false
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        conda.enabled = false
        apptainer.enabled = true
    }
    pbspro { process.executor = 'pbspro' }
    lsf { process.executor = 'lsf' }
    sge { process.executor = 'sge' }
    podman {
        podman.enabled = true
        // Map the image's non-root user to the caller, so task files stay readable.
        podman.runOptions = '--userns=keep-id --user $(id -u):$(id -g)'
    }
    shifter { shifter.enabled = true }
    test {
        params.cpus = 1
        params.memory = '2 GB'
        params.time = '5m'
        // Cap processes that size their own resources.
        process.resourceLimits = [cpus: 1, memory: 2.GB, time: 5.m]
        // Test tasks take seconds, so check on Slurm jobs every minute rather than the nersc
        // profile's 5. Slurm only: the local executor's default check is much more frequent.
        executor.'$slurm'.pollInterval = '1 min'
        executor.'$slurm'.queueStatInterval = '1 min'
    }
}
conda {
    useMicromamba = true
    cacheDir = "${params.workspace}/conda_cache"
    createTimeout = '1h'
}
apptainer {
    autoMounts = true
    cacheDir = "${params.workspace}/apptainer_cache"
}
podman {
    // Image pins have no registry; Perlmutter's podman searches registry.suse.com only.
    registry = "docker.io"
}
timeline {
    enabled = true
    overwrite = true
    file = "${params.publish_base}/trace/execution_timeline_${params.trace_timestamp}.html"
}
report {
    enabled = true
    overwrite = true
    file = "${params.publish_base}/trace/execution_report_${params.trace_timestamp}.html"
}
trace {
    enabled = true
    overwrite = true
    file = "${params.publish_base}/trace/execution_trace_${params.trace_timestamp}.txt"
}
dag {
    enabled = true
    overwrite = true
    file = "${params.publish_base}/trace/pipeline_dag_${params.trace_timestamp}.html"
}
