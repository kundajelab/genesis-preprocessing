// Bulk ATAC settings (workflows/atac-seq.nf), on top of the shared repository config.
includeConfig '../nextflow.config'

// nf-schema otherwise looks for the parameter schema beside the main script.
validation {
    parametersSchema = "${projectDir.parent}/assets/atac-seq.params.schema.json"
}
params {
    // bwa-mem2 options, the same for DAP-seq and bulk ATAC.
    bwa_batch_size = 10000000
    bwa_seed_length = 19
    bwa_max_seed_occurrences = 10000
    bwa_score_threshold = 30
    // Both mates must reach this MAPQ, as in ENCODE ATAC.
    atac_mapq = 30
    // Nextera adapter that Tn5 leaves on both mates.
    atac_adapter = 'CTGTCTCTTATACACATCT'
}
