// Cluster execution is opt-in. Authentication and cluster services are site-managed.
profiles {
    slurm {
        process.executor = 'slurm'
        executor.queueSize = 50
    }
    // Perlmutter CPU nodes. Tasks fit in one node, so the shared QOS charges only the cores
    // and memory used; podman-hpc resolves unqualified image names to another registry.
    nersc {
        process.executor = 'slurm'
        // podman-hpc's image mounts count against the job's memory (a 1.5 GB image fails a
        // 1 GB job), so Slurm gets 4 GB more than the task; this --mem follows and overrides
        // Nextflow's. The container itself is still limited to the task's memory.
        process.clusterOptions = {
            "--constraint=cpu --qos=${params.nersc_qos} --mem=${(task.memory ?: 1.GB).toMega() + 4096}M"
        }
        executor.queueSize = 15
        executor.pollInterval = '5 min'
        executor.queueStatInterval = '5 min'
        executor.submitRateLimit = '1 / 10 sec'
        podman.enabled = true
        podman.registry = 'docker.io'
        // The images run as a non-root user; map it to the caller so task files stay readable.
        podman.runOptions = '--userns=keep-id --user $(id -u):$(id -g)'
    }
    pbspro { process.executor = 'pbspro' }
    lsf { process.executor = 'lsf' }
    sge { process.executor = 'sge' }
    podman { podman.enabled = true }
    shifter { shifter.enabled = true }
}
