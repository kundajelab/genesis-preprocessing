// DAP-seq settings (workflows/dap-seq.nf), on top of the shared repository config.
includeConfig '../nextflow.config'

// nf-schema otherwise looks for the parameter schema beside the main script.
validation {
    parametersSchema = "${projectDir.parent}/assets/dap-seq.params.schema.json"
}
params {
    // bwa-mem3 options, the same for DAP-seq and bulk ATAC.
    bwa_batch_size = 10000000
    bwa_seed_length = 19
    // bwa-mem3's default, as bwa-mem2's. Repeats still align (as MAPQ 0); 10000 was 5x slower on
    // repeat-rich samples.
    bwa_max_seed_occurrences = 500
    bwa_score_threshold = 30
    // SPP cross-correlation aligns read 1 cut to this many bases, as ENCODE does.
    spp_read_length = 50
    spp_script = "${projectDir.parent}/vendor/phantompeakqualtools/run_spp.R"
}
