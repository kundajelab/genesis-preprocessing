// scATAC settings for raw 10x reads (workflows/scatac-reads.nf), on top of the shared repository
// config.
includeConfig '../nextflow.config'

params {
    scatac_min_fragments = 1000
    scatac_max_cells = 0
}

// nf-schema otherwise looks for the parameter schema beside the main script.
validation {
    parametersSchema = "${projectDir.parent}/assets/scatac-reads.params.schema.json"
}
