// TSS-mapping settings (workflows/tss-seq.nf), on top of the shared repository config.
includeConfig '../nextflow.config'

params {
    tss_cluster_min_tpm = 1
    tss_cluster_max_length = 200
}

// nf-schema otherwise looks for the parameter schema beside the main script.
validation {
    parametersSchema = "${projectDir.parent}/assets/tss-seq.params.schema.json"
}
